# Mining service memory settings.
#
# Copy this file to .env and adjust the values for the host running Docker.
# Docker Compose reads .env automatically for variable substitution.

# Hard memory limit for the Java mining container.
PROM_SERVICE_MEM_LIMIT=10g

# Each reusable calculation JVM gets this maximum heap; its initial heap is 16 MiB.
# Total worker heaps + native reserves + coordinator must fit PROM_SERVICE_MEM_LIMIT.
PROM_JAVA_XMX=8g
PROM_COORDINATOR_XMX=256m
PROM_WORKER_COUNT=1
PROM_EVALUATION_TIMEOUT_SECONDS=300
PROM_CANCEL_GRACE_SECONDS=10

# Outer HTTP timeout is separate from the evaluation deadline. The optimization
# client also negotiates a sufficient budget and capacity from /health.
JAVA_SERVICE_TIMEOUT_SECONDS=660
JAVA_CANCEL_GRACE_SECONDS=30

# Optional immutable identifiers recorded with new optimization experiments.
# Leave blank rather than using the mutable :develop tag as a revision.
PROM_SERVICE_REVISION=
MODEL_QUALITY_POLICY_VERSION=
