<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.minersweeper</groupId>
  <artifactId>prom-service</artifactId>
  <version>0.1.0</version>
  <name>prom-service</name>

  <properties>
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spark.version>2.9.4</spark.version>
    <jackson.version>2.17.2</jackson.version>
    <slf4j.version>2.0.16</slf4j.version>
    <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
    <maven.jar.plugin.version>3.4.2</maven.jar.plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.sparkjava</groupId>
      <artifactId>spark-core</artifactId>
      <version>${spark.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <dependency>
      <groupId>prom</groupId>
      <artifactId>AlphaMiner</artifactId>
      <version>6.9.78</version>
    </dependency>
    <dependency>
      <groupId>prom</groupId>
      <artifactId>ProM-Framework</artifactId>
      <version>6.10.110</version>
    </dependency>
    <dependency>
      <groupId>prom</groupId>
      <artifactId>ProM-Contexts</artifactId>
      <version>6.10.62</version>
    </dependency>
    <dependency>
      <groupId>prom</groupId>
      <artifactId>ProM-Plugins</artifactId>
      <version>6.9.70</version>
    </dependency>
    <dependency>
      <groupId>prom</groupId>
      <artifactId>Log</artifactId>
      <version>6.12.2</version>
    </dependency>
    <dependency>
      <groupId>prom</groupId>
      <artifactId>PetriNets</artifactId>
      <version>6.10.158</version>
    </dependency>
    <dependency>
      <groupId>org.deckfour</groupId>
      <artifactId>openxes</artifactId>
      <version>20211004</version>
    </dependency>
    <dependency>
      <groupId>prom.thirdparty</groupId>
      <artifactId>Uitopia</artifactId>
      <version>0.6-20190913</version>
    </dependency>
    <dependency>
      <groupId>prom.thirdparty</groupId>
      <artifactId>UITopiaResources</artifactId>
      <version>0.6-20190913</version>
    </dependency>
    <dependency>
      <groupId>prom.thirdparty</groupId>
      <artifactId>jgraph</artifactId>
      <version>5.13.0.4</version>
    </dependency>
    <dependency>
      <groupId>prom.thirdparty</groupId>
      <artifactId>slickerbox</artifactId>
      <version>1.0rc1</version>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>16.0.1</version>
    </dependency>
    <dependency>
      <groupId>commons-logging</groupId>
      <artifactId>commons-logging</artifactId>
      <version>1.1.3</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>1.13</version>
    </dependency>
    <dependency>
      <groupId>org.beanshell</groupId>
      <artifactId>bsh</artifactId>
      <version>2.0b4</version>
    </dependency>
    <dependency>
      <groupId>jargs</groupId>
      <artifactId>jargs</artifactId>
      <version>latest</version>
    </dependency>
    <dependency>
      <groupId>prom.thirdparty</groupId>
      <artifactId>TableLayout</artifactId>
      <version>20050920</version>
    </dependency>
    <dependency>
      <groupId>prom.thirdparty</groupId>
      <artifactId>Spex</artifactId>
      <version>1.1</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven.jar.plugin.version}</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>PromService</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
